# ─────────────────────────  Upstream API  ─────────────────────────
# The quota/usage endpoint you want to monitor. Any URL returning JSON works.
# Response fields are mapped via the FIELD_* vars below.
UPSTREAM_URL=https://your-api.example.com/stats

# Bearer token sent as: Authorization: Bearer <API_KEY>
# (GLM_API_KEY is still read as a legacy fallback.)
API_KEY=

# ─────────────────────────  Branding  ─────────────────────────
# Shown as the dashboard title and in every Telegram alert.
APP_NAME=LLM Quota

# Bot command prefix. Empty = /quota /reset /help.
# Set to "glm" -> /glmquota /glm /glmreset /glmhelp
BOT_COMMAND_PREFIX=

# Timezone for date/time formatting in alerts (PHP tz, e.g. UTC, Asia/Jakarta).
TZ=UTC

# ─────────────────────────  Field map (advanced)  ─────────────────────────
# Dotted JSON paths pointing at each value in your upstream response.
# Defaults match the original proxy contract — only override when your API
# uses different field names. Dot = nesting (a.b.c).
# FIELD_NAME=name
# FIELD_MODEL=model
# FIELD_LIMIT=token_limit_per_5h
# FIELD_USED=current_usage.tokens_used_in_current_window
# FIELD_REMAINING=current_usage.remaining_tokens
# FIELD_WINDOW_START=current_usage.window_started_at
# FIELD_WINDOW_END=current_usage.window_ends_at
# FIELD_TOTAL_REQUESTS=total_requests
# FIELD_TOTAL_LIFETIME=total_lifetime_tokens
# FIELD_IS_EXPIRED=is_expired
# FIELD_EXPIRY_DATE=expiry_date
# FIELD_LAST_USED=last_used

# ─────────────────────────  Database (MySQL)  ─────────────────────────
DB_HOST=127.0.0.1
DB_DATABASE=quota_dash
DB_USERNAME=quota_user
DB_PASSWORD=

# ─────────────────────────  Telegram alerts & bot  ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minutes before window reset to fire the "reset soon" alert.
ALERT_WINDOW_MINUTES=30

# Telegram webhook (optional). Set both, then run: php bin/set-webhook.php
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
