# Upstream GLM proxy API key (Bearer token).
GLM_API_KEY=glm_your_key_here

# MySQL connection for daily logging + alert dedup state.
DB_HOST=127.0.0.1
DB_DATABASE=quota_dash
DB_USERNAME=quota_user
DB_PASSWORD=

# Telegram bot: push alerts + /glmquota, /glmreset, /glmhelp commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minutes before window reset to fire the "reset soon" alert.
ALERT_WINDOW_MINUTES=30

# Telegram webhook (optional). Set both, then run: php bin/set-webhook.php
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

